# MongoDB connection string (required in production)
MONGO_URL=

# Legacy alias — use MONGO_URL instead when possible
ATLASDB_URL=

# Session encryption secret (required in production)
SESSION_SECRET=

# Cloudinary image upload (optional — uploads fall back to URL-only without these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Server port (optional, defaults to 8080)
PORT=8080

# Set to "production" when deploying
NODE_ENV=
