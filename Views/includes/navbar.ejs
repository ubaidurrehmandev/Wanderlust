<style>
  .search-btn {
    background-color: #fe424d;
    color: #fff;
    display: inline-flex;
    align-items: center;
    border-radius: 25px;
    padding: 0.5rem 1.25rem 0.5rem 1rem;
    border: none;
  }
  .search-btn:hover {
    background-color: #e03a44;
    color: #fff;
  }
  .search-btn i {
    margin-right: 0.5rem;
  }
  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 1.5rem;
    font-size: 0.95rem;
  }
</style>
<nav class="navbar navbar-expand-lg bg-body-light border-bottom sticky-top">
  <div class="container-fluid px-4">
    <a class="navbar-brand d-flex align-items-center" href="/listings">
      <i class="fa-regular fa-compass"></i>
      <span class="ms-2 fw-bold text-dark fs-5">Wanderlust</span>
    </a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <!-- <div class="navbar-nav me-auto">
        <a class="nav-link" href="/listings">Explore</a>
      </div> -->
      <div class="navbar-nav mx-auto">
        <form class="d-flex search-form" role="search" action="/listings" method="GET">
          <input
            class="form-control me-2 search-inp"
            type="search"
            placeholder="Search destinations..."
            name="search"
            value="<%= typeof search !== 'undefined' && search ? search : '' %>"
          />
          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i> Search
          </button>
        </form>
      </div>
      <div class="navbar-nav ms-auto align-items-center">
        <% if (currUser) { %>
          <a class="nav-link me-2" href="/listings/new">Airbnb your home</a>
          <span class="nav-link text-muted me-2"><b>Hi, <%= currUser.username %>!</b></span>
          <a class="nav-link btn btn-outline-secondary btn-sm px-3 py-1" href="/logout">Log Out</a>
        <% } else { %>
          <a class="nav-link" href="/signup"><b>Sign Up</b></a>
          <a class="nav-link" href="/login"><b>Log In</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>