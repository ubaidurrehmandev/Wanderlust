<% layout("/layouts/boilerplate") %> 

<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.75rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .filter {
    text-align: center;
    opacity: 0.7;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
    min-width: 60px;
    flex-shrink: 0;
  }

  .filter:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .filter.active {
    opacity: 1;
    border-bottom: 3px solid #fe424d;
    padding-bottom: 0.25rem;
  }

  .filter i {
    font-size: 1.3rem;
  }

  .filter p {
    font-size: 0.8rem;
    margin-top: 0.4rem;
    margin-bottom: 0;
  }
</style>

<!-- Filter Categories -->
<div id="filters">
  <div class="filter" onclick="filterByCategory('Trending')">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
  <div class="filter" onclick="filterByCategory('Rooms')">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>
  <div class="filter" onclick="filterByCategory('Iconic Cities')">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic Cities</p>
  </div>
  <div class="filter" onclick="filterByCategory('Mountains')">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </div>
  <div class="filter" onclick="filterByCategory('Castle')">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castle</p>
  </div>
  <div class="filter" onclick="filterByCategory('Amazing Pools')">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing Pools</p>
  </div>
  <div class="filter" onclick="filterByCategory('Camping')">
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
  </div>
  <div class="filter" onclick="filterByCategory('Farms')">
    <div><i class="fa-solid fa-tractor"></i></div>
    <p>Farms</p>
  </div>
  <div class="filter" onclick="filterByCategory('Arctic')">
    <div><i class="fa-regular fa-snowflake"></i></div>
    <p>Arctic</p>
  </div>
  <div class="filter" onclick="filterByCategory('Beach')">
    <div><i class="fa-solid fa-umbrella-beach"></i></div>
    <p>Beach</p>
  </div>
  <div class="filter" onclick="filterByCategory('Luxury')">
    <div><i class="fa-solid fa-gem"></i></div>
    <p>Luxury</p>
  </div>
  <div class="filter" onclick="filterByCategory('Adventure')">
    <div><i class="fa-solid fa-mountain-sun"></i></div>
    <p>Adventure</p>
  </div>
</div>

<% if (category || search) { %>
  <div class="alert alert-info d-flex align-items-center justify-content-between mt-2 mb-4" role="alert">
    <div>
      <% if (search) { %>
        <span>Search: <strong>"<%= search %>"</strong></span>
      <% } %>
      <% if (category && search) { %> | <% } %>
      <% if (category) { %>
        <span>Category: <strong>"<%= category %>"</strong></span>
      <% } %>
    </div>
    <a href="/listings" class="btn btn-sm btn-outline-dark">Clear Filter</a>
  </div>
<% } %>

<% if (!allListings || allListings.length === 0) { %>
  <div class="alert alert-warning text-center mt-4 p-4" role="alert">
    <h5>No listings found</h5>
    <p class="mb-2">Try adjusting your filters or search keywords to find what you're looking for.</p>
    <a href="/listings" class="btn btn-dark btn-sm">View All Listings</a>
  </div>
<% } else { %>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 mt-1">
    <% for (let listing of allListings) { %>
      <div class="col">
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="listing-card card h-100 shadow-sm border-0">
            <img
              src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=60' %>"
              class="card-img-top"
              alt="<%= listing.title %>"
              style="height: 18rem; object-fit: cover;"
            />
            <div class="card-body">
              <p class="card-text">
                <strong class="fs-6"><%= listing.title %></strong>
                <br>
                <span class="text-muted"><%= listing.location %>, <%= listing.country %></span>
                <br>
                <b>&#8360; <%= (listing.price !== undefined && listing.price !== null) ? Number(listing.price).toLocaleString("en-PK") : "0" %></b> <small class="text-muted">/ night</small>
                <% if (listing.propertyType) { %>
                  <span class="badge bg-light text-dark border ms-1"><%= listing.propertyType %></span>
                <% } %>
              </p>
            </div>
          </div>
        </a>
      </div>
    <% } %>
  </div>
<% } %>

<script>
  function filterByCategory(categoryName) {
    const urlParams = new URLSearchParams(window.location.search);
    const currentCategory = urlParams.get('category');
    
    // Toggle off if already active
    if (currentCategory === categoryName) {
      urlParams.delete('category');
    } else {
      urlParams.set('category', categoryName);
    }
    
    const queryString = urlParams.toString();
    window.location.href = queryString ? `/listings?${queryString}` : '/listings';
  }

  document.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);
    const activeCategory = urlParams.get('category');
    
    if (activeCategory) {
      const filters = document.querySelectorAll('.filter');
      filters.forEach(filter => {
        const p = filter.querySelector('p');
        if (p && p.textContent.trim().toLowerCase() === activeCategory.trim().toLowerCase()) {
          filter.classList.add('active');
        }
      });
    }
  });
</script>