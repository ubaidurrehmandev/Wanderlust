<% layout("/layouts/boilerplate") -%>

<div class="row mt-3 mb-5">
  <div class="col-lg-8 col-md-10 col-12 mx-auto">
    <h3 class="fw-bold mb-3">Create a New Listing</h3>

    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input name="listing[title]" id="title" type="text" class="form-control" placeholder="Add a catchy title" required />
        <div class="invalid-feedback">Please enter a title.</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" id="description" rows="4" class="form-control" placeholder="Describe the place, vibe, amenities, etc." required></textarea>
        <div class="invalid-feedback">Please enter a description.</div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-6">
          <label for="imageFile" class="form-label">Upload Image (File)</label>
          <input id="imageFile" name="image" type="file" accept="image/*" class="form-control" />
          <div class="form-text">On localhost, uploaded files are stored in `public/uploads` and displayed from `/uploads/...`.</div>
        </div>
        <div class="mb-3 col-md-6">
          <label for="imageUrl" class="form-label">Or Image URL</label>
          <input id="imageUrl" name="listing[image][url]" placeholder="https://example.com/photo.jpg" type="url" class="form-control" />
        </div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price (PKR / Night)</label>
          <input name="listing[price]" id="price" placeholder="1200" type="number" min="0" class="form-control" required />
          <div class="invalid-feedback">Please enter a valid price.</div>
        </div>
        <div class="mb-3 col-md-4">
          <label for="location" class="form-label">City / Location</label>
          <input name="listing[location]" id="location" placeholder="e.g. Lahore" type="text" class="form-control" required />
          <div class="invalid-feedback">Please enter a location.</div>
        </div>
        <div class="mb-3 col-md-4">
          <label for="country" class="form-label">Country</label>
          <input name="listing[country]" id="country" placeholder="e.g. Pakistan" type="text" class="form-control" required />
          <div class="invalid-feedback">Please enter a country.</div>
        </div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="category" class="form-label">Category</label>
          <select name="listing[category]" id="category" class="form-select">
            <option value="">Select a Category (optional)</option>
            <option value="Trending">Trending</option>
            <option value="Rooms">Rooms</option>
            <option value="Iconic Cities">Iconic Cities</option>
            <option value="Mountains">Mountains</option>
            <option value="Castle">Castle</option>
            <option value="Amazing Pools">Amazing Pools</option>
            <option value="Camping">Camping</option>
            <option value="Farms">Farms</option>
            <option value="Arctic">Arctic</option>
            <option value="Beach">Beach</option>
            <option value="City">City</option>
            <option value="Countryside">Countryside</option>
            <option value="Luxury">Luxury</option>
            <option value="Adventure">Adventure</option>
            <option value="Cultural">Cultural</option>
            <option value="Skiing">Skiing</option>
            <option value="Historical">Historical</option>
          </select>
        </div>

        <div class="mb-3 col-md-4">
          <label for="propertyType" class="form-label">Property Type</label>
          <select name="listing[propertyType]" id="propertyType" class="form-select">
            <option value="">Select Property Type (optional)</option>
            <option value="Hotel">Hotel</option>
            <option value="Apartment">Apartment</option>
            <option value="House">House</option>
            <option value="Villa">Villa</option>
            <option value="Resort">Resort</option>
            <option value="Cottage">Cottage</option>
            <option value="Studio">Studio</option>
            <option value="Hostel">Hostel</option>
            <option value="Cabin">Cabin</option>
            <option value="Farmhouse">Farmhouse</option>
            <option value="Houseboat">Houseboat</option>
            <option value="Chalet">Chalet</option>
          </select>
        </div>

        <div class="mb-3 col-md-4">
          <label for="maxGuests" class="form-label">Max Guests</label>
          <input name="listing[maxGuests]" id="maxGuests" type="number" class="form-control" min="1" max="100" placeholder="e.g. 4" />
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Amenities</label>
        <div class="row row-cols-2 row-cols-md-3 g-2">
          <% const allAmenities = ["WiFi", "Parking", "Pool", "Kitchen", "AC", "Heating", "Laundry", "Garden", "TV", "Gym", "Balcony", "Fireplace", "Washer", "Dryer", "Dishwasher", "Iron", "Hair Dryer"]; %>
          <% for (let a of allAmenities) { %>
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="listing[amenities]" value="<%= a %>" id="amenity_<%= a %>" />
                <label class="form-check-label" for="amenity_<%= a %>"><%= a %></label>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <button class="btn btn-dark add-btn mt-3 px-4 py-2">Create Listing</button>
    </form>
  </div>
</div>