<% layout("/layouts/boilerplate") -%>

<div class="row mt-3">
  <!-- Listing Title -->
  <div class="col-lg-8 col-md-10 col-12 mx-auto">
    <h3 class="fw-bold mb-3"><%= listing.title %></h3>
  </div>

  <!-- Listing Card -->
  <div class="listing-card col-lg-8 col-md-10 col-12 mx-auto show-card">
    <img
      src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=60' %>"
      class="card-img-top show-img rounded-3"
      alt="<%= listing.title %>"
      style="height: 24rem; object-fit: cover;"
    />

    <div class="card-body mt-3">
      <p class="card-text">
        <span class="text-muted">Owned by <i><%= listing.owner ? listing.owner.username : "Wanderlust Host" %></i></span>
      </p>
      <p class="card-text fs-6">
        <%= listing.description %>
      </p>

      <ul class="list-group list-group-flush mb-3">
        <li class="list-group-item ps-0">
          <strong>Price:</strong> &#8360; <%= (listing.price !== undefined && listing.price !== null) ? Number(listing.price).toLocaleString("en-PK") : "0" %> <span class="text-muted">/ night</span>
        </li>
        <li class="list-group-item ps-0">
          <strong>Location:</strong> <%= listing.location %>, <%= listing.country %>
        </li>
        <% if (listing.category) { %>
          <li class="list-group-item ps-0">
            <strong>Category:</strong> <span class="badge bg-secondary"><%= listing.category %></span>
          </li>
        <% } %>
        <% if (listing.propertyType) { %>
          <li class="list-group-item ps-0">
            <strong>Property Type:</strong> <%= listing.propertyType %>
          </li>
        <% } %>
        <% if (listing.maxGuests) { %>
          <li class="list-group-item ps-0">
            <strong>Max Guests:</strong> <%= listing.maxGuests %>
          </li>
        <% } %>
        <% if (listing.amenities && listing.amenities.length > 0) { %>
          <li class="list-group-item ps-0">
            <strong>Amenities:</strong>
            <div class="d-flex flex-wrap gap-1 mt-1">
              <% for (let amenity of listing.amenities) { %>
                <span class="badge bg-light text-dark border"><%= amenity %></span>
              <% } %>
            </div>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
  
  <!-- Edit / Delete Listing (Owner Only) -->
<% const isListingOwner = currUser && listing.owner && `${currUser._id}` === `${listing.owner._id}`; %>
<% if (isListingOwner) { %>
  <div class="col-lg-8 col-md-10 col-12 mx-auto mt-4 d-flex gap-2">

    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn px-4">
      Edit
    </a>

    <form
      method="POST"
      action="/listings/<%= listing._id %>?_method=DELETE"
      onsubmit="return confirm('Are you sure you want to delete this listing?');"
    >
      <button type="submit" class="btn btn-outline-danger">
        Delete
      </button>
    </form>

  </div>
<% } %>
  
  <!-- Location Map -->
  <div class="col-lg-8 col-md-10 col-12 mx-auto mt-3">
    <h5>Where you'll be</h5>
    <% if (listing.coordinates && typeof listing.coordinates.lat === 'number' && typeof listing.coordinates.lng === 'number') { %>
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
      <div id="map" class="rounded-3 shadow-sm" style="height: 320px; width: 100%;"></div>
      <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
      <script>
        (function() {
          const lat = <%= listing.coordinates.lat %>;
          const lng = <%= listing.coordinates.lng %>;
          const map = L.map('map').setView([lat, lng], 13);
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap contributors'
          }).addTo(map);
          L.marker([lat, lng])
            .addTo(map)
            .bindPopup("<b><%= listing.title %></b><br><%= listing.location %>")
            .openPopup();
        })();
      </script>
    <% } else { %>
      <p class="text-muted"><i class="fa-solid fa-location-dot me-1"></i> <%= listing.location %>, <%= listing.country %></p>
    <% } %>
  </div>


  <!-- Reviews Section -->
  <div class="col-lg-8 col-md-10 col-12 mx-auto mt-4">
    <hr />

    <!-- Leave a Review -->
    <% if (currUser) { %>
      <h4>Write a Review</h4>
      <p class="text-muted mb-2">Logged in as: <strong><%= currUser.username %></strong></p>
      <form class="mb-4 needs-validation" action="/listings/<%= listing._id %>/reviews" method="POST" novalidate>
        <!-- Star Rating -->
        <fieldset class="starability-basic mt-3">
          <legend class="fs-6">Rating:</legend>
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>

        <!-- Comment -->
        <div class="mb-3 mt-2">
          <label for="comment" class="form-label">Comments</label>
          <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" placeholder="Share your experience..." required></textarea>
          <div class="invalid-feedback">Please enter your feedback before submitting.</div>
        </div>

        <button class="btn btn-outline-dark">Submit Review</button>
      </form>
    <% } %>

    <!-- All Reviews -->
    <% if (listing.reviews && listing.reviews.length > 0) { %>
      <h5>All Reviews (<%= listing.reviews.length %>)</h5>
      <div class="row g-3 mt-2">
        <% for (let review of listing.reviews) { %>
          <div class="col-md-6 col-12">
            <div class="card h-100 shadow-sm border-0 bg-light p-3">
              <div class="card-body p-0">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <strong class="card-title mb-0">
                    <%= review.author ? review.author.username : "Anonymous" %>
                  </strong>
                  <% const isReviewAuthor = currUser && review.author && `${currUser._id}` === `${review.author._id}`; %>
                  <% if (isReviewAuthor) { %>
                    <div class="d-flex align-items-center gap-2">
                      <button
                        class="btn btn-sm btn-outline-dark"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#review-edit-<%= review._id %>"
                        aria-expanded="false"
                        aria-controls="review-edit-<%= review._id %>"
                      >
                        Edit
                      </button>
                      <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" onsubmit="return confirm('Delete this review?');">
                        <button class="btn btn-sm text-danger p-0 border-0 bg-transparent" type="submit">
                          <i class="fa-solid fa-trash-can"></i>
                        </button>
                      </form>
                    </div>
                  <% } %>
                </div>
                <p class="starability-result mb-2" data-rating="<%= review.rating %>">
                  Rated: <%= review.rating %> stars
                </p>
                <p class="card-text mb-0 text-secondary"><%= review.comment %></p>
                <% if (isReviewAuthor) { %>
                  <div class="collapse mt-3" id="review-edit-<%= review._id %>">
                    <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=PUT" method="POST" class="needs-validation" novalidate>
                      <div class="mb-2">
                        <label for="rating-<%= review._id %>" class="form-label">Rating</label>
                        <select id="rating-<%= review._id %>" name="review[rating]" class="form-select" required>
                          <% for (let i = 1; i <= 5; i++) { %>
                            <option value="<%= i %>" <%= review.rating === i ? "selected" : "" %>><%= i %></option>
                          <% } %>
                        </select>
                      </div>
                      <div class="mb-2">
                        <label for="comment-<%= review._id %>" class="form-label">Edit comment</label>
                        <textarea id="comment-<%= review._id %>" name="review[comment]" rows="3" class="form-control" required><%= review.comment %></textarea>
                      </div>
                      <button class="btn btn-sm btn-dark" type="submit">Save Review</button>
                    </form>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <p class="text-muted">No reviews yet. Be the first to leave a review!</p>
    <% } %>
  </div>
</div>